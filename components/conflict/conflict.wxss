@import '../../wxss/component.wxss';
.conflict-intro{font-size:15px;margin-bottom:18px}.conflict-card{display:flex;align-items:center;gap:20px;padding:12px 16px;min-height:86px;border:1px solid #E0E1DC;border-radius:8px;margin-top:10px}.conflict-position{font-size:22px;line-height:1.3}.phone-symbol{width:18px;height:32px;border:2px solid #244F3E;border-radius:3px;margin:0 8px;position:relative;flex-shrink:0}.phone-symbol::before{content:"";position:absolute;top:3px;left:4px;right:4px;height:1px;background:#244F3E}.action,.ui-button.ui-button.action{margin-top:9px;padding:8px 12px;color:#244F3E}.conflict-card+.action,.conflict-card+.ui-button.ui-button.action{margin-top:16px}.later,.ui-button.ui-button.later{text-align:center;font-size:14px}.conflict-hint{text-align:center;font-size:11px;color:#858A88;margin-top:8px}
