:host{display:block;flex-shrink:0}.nav{background:#F9F8F5;box-sizing:border-box}.nav-bar{display:flex;align-items:center;box-sizing:border-box;padding-left:20px;gap:12px}.nav-title{font-family:"Times New Roman","Songti SC",SimSun,serif;font-size:20px;line-height:1.3;color:#101A1C;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.nav-brand{font-weight:600}.nav-back,.ui-button.ui-button.nav-back{display:flex;align-items:center;justify-content:center;background:none;border:0;margin:0 0 0 -12px;padding:0;width:32px;height:44px;flex-shrink:0}.nav-back::after,.ui-button.ui-button.nav-back::after{border:0}.nav-pressed{opacity:.6}
