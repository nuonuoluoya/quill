<view class="dock {{state.mode==='sentence'?'sentence-dock':''}}">
  <view class="between heading"><text class="dock-heading">{{state.mode==='sentence'?number+' / '+total:'全文播放 · '+title}}</text><button size="default" wx:if="{{state.mode==='sentence'}}" class="quiet locate" bindtap="locate"><q-icon name="document" size="20"/>定位原文</button><button size="default" wx:else class="quiet" data-action="sentence" bindtap="action">返回逐句</button><button wx:if="{{state.mode==='sentence'}}" size="default" class="shadow-entry" disabled="{{frozen}}" bindtap="shadow"><view class="pill-border" aria-hidden="true"/><q-icon name="microphone" color="green" size="21"/>跟读</button></view>
  <block wx:if="{{state.mode==='chapter'}}"><view class="bar"><view style="width:{{percent}}%"/></view><view class="between small muted"><text>{{current}}</text><text>{{duration}}</text></view></block>
  <view wx:if="{{state.error}}" class="playback-error"><view>音频暂时无法播放</view><view class="small muted">{{state.error}}，原文仍可阅读。</view><button size="default" class="action primary retry-play" disabled="{{frozen}}" data-action="toggle" bindtap="action"><q-icon name="refresh" color="white" size="21"/><text>重试播放</text></button></view>
  <view wx:else class="controls">
    <button size="default" class="side" wx:if="{{state.mode==='sentence'}}" disabled="{{frozen || state.index===0}}" data-action="previous" bindtap="action"><view class="round-control"><q-icon name="previous" size="23"/></view><text>上一句</text></button>
    <button size="default" wx:else class="side" disabled="{{frozen}}" data-action="restart" bindtap="action"><view class="round-control"><q-icon name="refresh" size="23"/></view><text>从头播放</text></button>
    <button size="default" class="play" disabled="{{frozen || state.status==='unavailable'}}" data-action="toggle" bindtap="action" aria-label="{{state.status==='playing'?'暂停播放':state.status==='loading'?'取消加载':'开始播放'}}"><text wx:if="{{state.status==='loading'}}" class="loading">···</text><q-icon wx:else name="{{state.status==='playing'?'pause':'play'}}" color="white" size="30"/></button>
    <button size="default" class="side" wx:if="{{state.mode==='sentence'}}" disabled="{{frozen || state.index>=chapter.sentences.length-1}}" data-action="next" bindtap="action"><view class="round-control"><q-icon name="next" size="23"/></view><text>下一句</text></button>
    <button size="default" wx:else class="side" disabled="{{frozen}}" bindtap="speedPanel"><view class="round-control speed-text">{{state.effectiveSpeed}}×</view></button>
  </view>
  <view wx:if="{{speedOpen}}" class="choices"><button size="default" wx:for="{{speeds}}" wx:key="*this" class="choice {{state.speed===item?'active':''}}" data-value="{{item}}" disabled="{{frozen || (!state.speedSupported && item!==1)}}" bindtap="speed">{{item}}×</button></view>
  <view wx:if="{{state.mode==='sentence'}}" class="options"><button size="default" class="speed-text speed-picker" disabled="{{frozen}}" bindtap="speedPanel" aria-label="选择倍速，当前 {{state.effectiveSpeed}} 倍"><view class="pill-border" aria-hidden="true"/>{{state.effectiveSpeed}}×<q-icon name="chevron-down" size="18"/></button><view class="option-divider"/><button size="default" class="option {{state.loop?'enabled':''}}" aria-pressed="{{state.loop}}" disabled="{{frozen}}" data-action="loop" bindtap="action"><q-icon name="repeat" color="{{state.loop?'green':'ink'}}" size="23"/><text>本句循环</text></button><view class="option-divider"/><button size="default" class="option {{state.continuous?'enabled':''}}" aria-pressed="{{state.continuous}}" disabled="{{frozen}}" data-action="continuous" bindtap="action"><q-icon name="infinity" color="{{state.continuous?'green':'ink'}}" size="25"/><text>{{isPodcast?'段内连播':'章内连播'}}</text></button></view>
  <view wx:else class="small muted hint">{{isPodcast?'当前部分播放完成即停止':'当前章节播放完成即停止'}}</view>
  <view wx:if="{{!state.speedSupported}}" class="small muted hint">当前环境使用 1× 播放，倍速偏好已保留</view><view wx:if="{{state.status==='unavailable'}}" class="small muted hint">本句暂无逐句音频</view>
</view>
<view wx:if="{{loadingModal}}" class="loading-overlay" catchtouchmove="preventMove">
  <view class="loading-dialog" role="dialog" aria-modal="true" aria-label="{{loadingKind==='buffering'?'音频缓冲中':'正在准备音频'}}">
    <view class="loading-title">{{loadingKind==='buffering'?'音频缓冲中':'正在准备音频'}}</view>
    <view class="loading-description muted" role="status">请稍候，就绪后将自动播放。</view>
    <button size="default" class="action outline cancel-loading" bindtap="cancelLoading">取消播放</button>
  </view>
</view>
