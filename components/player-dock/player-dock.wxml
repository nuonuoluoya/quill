<view class="ui-view dock {{state.mode==='sentence'?'sentence-dock':''}}">
  <view class="ui-view between heading"><text class="ui-text dock-heading">{{state.mode==='sentence'?number+' / '+total:'全文播放 · '+title}}</text><button size="default" wx:if="{{state.mode==='sentence'}}" class="ui-button quiet locate" bindtap="locate"><q-icon name="document" size="20"/>定位原文</button><button size="default" wx:else class="ui-button quiet" data-action="sentence" bindtap="action">返回逐句</button><button wx:if="{{state.mode==='sentence'}}" size="default" class="ui-button {{(frozen)?'is-disabled':''}} shadow-entry" disabled="{{frozen}}" bindtap="shadow"><view class="ui-view pill-border" aria-hidden="true"/><q-icon name="microphone" color="green" size="21"/>跟读</button></view>
  <block wx:if="{{state.mode==='chapter'}}"><view class="ui-view bar"><view style="width:{{percent}}%" class="ui-view"/></view><view class="ui-view between small muted"><text class="ui-text">{{current}}</text><text class="ui-text">{{duration}}</text></view></block>
  <view wx:if="{{state.error}}" class="ui-view playback-error"><view class="ui-view">音频暂时无法播放</view><view class="ui-view small muted">{{state.error}}，原文仍可阅读。</view><button size="default" class="ui-button {{(frozen)?'is-disabled':''}} action primary retry-play" disabled="{{frozen}}" data-action="toggle" bindtap="action"><q-icon name="refresh" color="white" size="21"/><text class="ui-text">重试播放</text></button></view>
  <view wx:else class="ui-view controls">
    <button size="default" class="ui-button {{(frozen || state.index===0)?'is-disabled':''}} side" wx:if="{{state.mode==='sentence'}}" disabled="{{frozen || state.index===0}}" data-action="previous" bindtap="action"><view class="ui-view round-control"><q-icon name="previous" size="23"/></view><text class="ui-text">上一句</text></button>
    <button size="default" wx:else class="ui-button {{(frozen)?'is-disabled':''}} side" disabled="{{frozen}}" data-action="restart" bindtap="action"><view class="ui-view round-control"><q-icon name="refresh" size="23"/></view><text class="ui-text">从头播放</text></button>
    <button size="default" class="ui-button {{(frozen || state.status==='unavailable')?'is-disabled':''}} play" disabled="{{frozen || state.status==='unavailable'}}" data-action="toggle" bindtap="action" aria-label="{{state.status==='playing'?'暂停播放':state.status==='loading'?'取消加载':'开始播放'}}"><text wx:if="{{state.status==='loading'}}" class="ui-text loading">···</text><q-icon wx:else name="{{state.status==='playing'?'pause':'play'}}" color="white" size="30"/></button>
    <button size="default" class="ui-button {{(frozen || state.index>=chapter.sentences.length-1)?'is-disabled':''}} side" wx:if="{{state.mode==='sentence'}}" disabled="{{frozen || state.index>=chapter.sentences.length-1}}" data-action="next" bindtap="action"><view class="ui-view round-control"><q-icon name="next" size="23"/></view><text class="ui-text">下一句</text></button>
    <button size="default" wx:else class="ui-button {{(frozen)?'is-disabled':''}} side" disabled="{{frozen}}" bindtap="speedPanel"><view class="ui-view round-control speed-text">{{state.effectiveSpeed}}×</view></button>
  </view>
  <view wx:if="{{speedOpen}}" class="ui-view choices"><button size="default" wx:for="{{speeds}}" wx:key="*this" class="ui-button {{(frozen || (!state.speedSupported && item!==1))?'is-disabled':''}} choice {{state.speed===item?'active':''}}" data-value="{{item}}" disabled="{{frozen || (!state.speedSupported && item!==1)}}" bindtap="speed">{{item}}×</button></view>
  <view wx:if="{{state.mode==='sentence'}}" class="ui-view options">
    <button size="default" class="ui-button {{(frozen)?'is-disabled':''}} option {{state.continuous?'enabled':''}}" aria-pressed="{{state.continuous}}" disabled="{{frozen}}" data-action="continuous" bindtap="action"><q-icon name="infinity" color="{{state.continuous?'green':'ink'}}" size="25"/><text class="ui-text">{{isPodcast?'段内连播':'章内连播'}}</text></button>
    <view class="ui-view option-divider" aria-hidden="true"/>
    <button size="default" class="ui-button {{(frozen)?'is-disabled':''}} option {{state.loop?'enabled':''}}" aria-pressed="{{state.loop}}" disabled="{{frozen}}" data-action="loop" bindtap="action"><q-icon name="repeat" color="{{state.loop?'green':'ink'}}" size="23"/><text class="ui-text">本句循环</text></button>
    <view class="ui-view option-divider" aria-hidden="true"/>
    <button size="default" class="ui-button {{(frozen)?'is-disabled':''}} speed-text speed-picker" disabled="{{frozen}}" bindtap="speedPanel" aria-label="选择倍速，当前 {{state.effectiveSpeed}} 倍"><view class="ui-view pill-border" aria-hidden="true"/>{{state.effectiveSpeed}}×<q-icon name="chevron-down" size="18"/></button>
  </view>
  <view wx:else class="ui-view small muted hint">{{isPodcast?'当前部分播放完成即停止':'当前章节播放完成即停止'}}</view>
  <view wx:if="{{!state.speedSupported}}" class="ui-view small muted hint">当前环境使用 1× 播放，倍速偏好已保留</view><view wx:if="{{state.status==='unavailable'}}" class="ui-view small muted hint">本句暂无逐句音频</view>
</view>
<view wx:if="{{loadingModal}}" class="ui-view loading-overlay" catchtouchmove="preventMove">
  <view class="ui-view loading-dialog" role="dialog" aria-modal="true" aria-label="{{loadingKind==='buffering'?'音频缓冲中':'正在准备音频'}}">
    <view class="ui-view loading-title">{{loadingKind==='buffering'?'音频缓冲中':'正在准备音频'}}</view>
    <view class="ui-view loading-description muted" role="status">请稍候，就绪后将自动播放。</view>
    <button size="default" class="ui-button action outline cancel-loading" bindtap="cancelLoading">取消播放</button>
  </view>
</view>
