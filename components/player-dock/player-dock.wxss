@import '../../wxss/common.wxss';
.dock{padding:4px 18px calc(18px + env(safe-area-inset-bottom));border-top:1px solid #DCDDD8;background:#F9F8F5}.heading{min-height:38px;gap:12px}.dock-heading{font-family:"Times New Roman","Songti SC",SimSun,serif;font-size:16px;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.heading .quiet,.heading button[size="default"].quiet{font-size:14px;color:#687078;flex-shrink:0}.controls{display:flex;align-items:center;justify-content:space-around;padding:4px 0 18px}.side,button[size="default"].side{display:flex;flex-direction:column;align-items:center;gap:7px;font-size:12px;min-width:64px;color:#687078}.play,button[size="default"].play{display:flex;align-items:center;justify-content:center;background:#244F3E;color:#fff;width:70px;height:70px;border-radius:50%}.round-control{width:38px;height:38px;border-radius:50%;border:1px solid #D4D7D1;display:flex;align-items:center;justify-content:center}.options{display:flex;align-items:center;justify-content:space-around;color:#687078;font-size:12px;gap:16px}.option,button[size="default"].option{display:flex;flex-direction:column;align-items:center;gap:5px;min-width:70px}.enabled{color:#244F3E;font-weight:600}.option.enabled,button[size="default"].option.enabled{background:#E8EEE7;border-radius:8px}.speed-text,button[size="default"].speed-text{font-family:"Times New Roman",serif;font-size:18px;color:#101A1C;min-width:48px}.hint{text-align:center;margin-top:8px;font-size:12px}.bar{height:4px;border-radius:4px;background:#DFE0DC;margin:8px 0 6px;overflow:hidden}.bar view{height:100%;background:#2C624D;border-radius:4px}.choices{justify-content:center;margin:0 0 14px}.loading{font-size:26px}.playback-error{text-align:center;padding:12px 0 18px;border-top:1px solid #DCDDD8;margin-top:8px}.playback-error .small,.playback-error button[size="default"].small{margin-top:6px}.retry-play,button[size="default"].retry-play{display:flex;align-items:center;justify-content:center;gap:12px;padding:12px}.dock .primary,.dock button[size="default"].primary{color:#fff}

.retry-play,button[size="default"].retry-play{width:100%}
.loading-overlay{position:fixed;inset:0;z-index:200;display:flex;align-items:center;justify-content:center;background:rgba(20,25,23,.44)}
.loading-dialog{width:calc(100% - 64px);max-width:340px;box-sizing:border-box;padding:26px 22px 20px;border-radius:18px;background:#F9F8F5;text-align:center}
.loading-title{font-size:21px;font-weight:600;line-height:1.4;color:#101A1C}.loading-description{font-size:14px;line-height:1.6;margin:12px 0 22px}
.cancel-loading,button[size="default"].cancel-loading{width:100%;margin:0;padding:10px 12px;font-size:16px}
