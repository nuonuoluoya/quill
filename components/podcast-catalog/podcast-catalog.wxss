:host{display:block}.podcast-catalog{color:#101A1C;font-size:15px}.ui-button{font:inherit;color:inherit;line-height:1.4;margin:0;background:transparent;border-radius:0;text-align:left}.ui-button::after{border:0}.ui-button.is-disabled{color:#818786;background:transparent}.episode-search{display:flex;align-items:center;gap:10px;background:#EEEDE8;border-radius:12px;padding:10px 12px;margin-top:14px}.episode-search .ui-input{flex:1;min-width:0;height:26px;font-size:15px}.clear{padding:4px 0 4px 8px;font-size:13px;color:#28543F}.result-count{font-size:12px;color:#687078;padding:12px 0}.episode{border-bottom:1px solid #DCDDD8}.episode-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;padding:17px 4px}.episode-copy{flex:1;min-width:0}.episode-number{display:block;font-size:12px;color:#687078;margin-bottom:5px}.episode-title{display:block;font-family:"Times New Roman","Songti SC",serif;font-size:21px;line-height:1.25;overflow-wrap:break-word}.chevron{flex-shrink:0;display:flex}.chevron.up{transform:rotate(180deg)}.parts{padding:0 0 12px}.part{width:100%;display:flex;align-items:center;justify-content:space-between;gap:8px;padding:14px 12px;border-radius:9px;background:#F0F1EC;margin-bottom:6px}.part.current{background:#E8EEE7;box-shadow:inset 3px 0 #2C624D}.part.is-disabled{background:#F0EFEB}.part-copy{min-width:0}.part-label{display:block;font-size:16px;color:#28543F}.part.is-disabled .part-label{color:#818786}.part-meta{display:block;font-size:12px;color:#687078;margin-top:5px}.current-label{font-size:12px;color:#28543F;white-space:nowrap}.pagination{display:flex;align-items:center;justify-content:space-between;margin:20px 0 6px;gap:10px;font-size:13px;color:#687078}.pagination .ui-button{padding:11px 14px;border:1px solid #D4D7D1;border-radius:9px;color:#28543F;font-size:14px}.pagination .ui-button.is-disabled{color:#A1A5A0;border-color:#E2E3DE}.no-results{padding:28px 0;text-align:center;color:#687078}
.episode-list{height:45vh}.compact .episode-list{height:32vh}.ui-button.ui-button.episode-heading,.ui-button.ui-button.part{width:100%;margin-left:0;margin-right:0;box-sizing:border-box}.ui-button.ui-button.clear{width:auto;min-width:0;padding:4px 0 4px 8px}.pagination .ui-button.ui-button{width:auto;min-width:0;margin:0}
.ui-button.ui-button.episode-heading{height:auto;min-height:64px;padding:17px 4px;background:transparent}.ui-button.ui-button.part{height:auto;min-height:68px;padding:14px 12px;border-radius:9px;background:#F0F1EC;margin-bottom:6px}.ui-button.ui-button.part.current{background:#E8EEE7;box-shadow:inset 3px 0 #2C624D}.ui-button.ui-button.part.is-disabled{background:#F0EFEB}
