:host{display:block}
.sentence-shell{position:relative;margin:0 10px;overflow:hidden;border-radius:8px}
.sentence{box-sizing:border-box;display:flex;align-items:flex-start;gap:12px;padding:14px 8px;position:relative;min-height:75px;background:#F9F8F5;transition:transform .16s ease}
.sentence::after{content:"";position:absolute;bottom:0;left:8px;right:8px;height:1px;background:#DCDDD8}
.sentence.selected{background:#E8EEE7;border-radius:8px}
.sentence.selected::before{content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:#244F3E;border-radius:4px 0 0 4px}
.sentence.selected::after{display:none}
.sentence.opened{transform:translateX(-72px)}
.sentence-no{font-family:"Times New Roman",serif;font-size:18px;color:#687078;line-height:28px;width:29px;flex-shrink:0;margin-top:1px}
.ui-button.play-target{box-sizing:border-box;display:flex;align-items:flex-start;justify-content:center;width:44px;min-width:44px;min-height:44px;padding:3px 8px 0;margin:0;background:transparent;border:0;border-radius:0;line-height:normal}
.play-target::after,.source::after,.favorite-action::after{border:0}
.sentence-play{box-sizing:border-box;display:flex;align-items:center;justify-content:center;width:28px;height:28px;flex-shrink:0;border:1px solid #687078;border-radius:50%}
.selected .sentence-no{color:#101A1C}
.selected .sentence-play{background:#244F3E;border-color:#244F3E}
.sentence-play.no-audio,.selected .sentence-play.no-audio{background:transparent;border-color:transparent}
.copy{flex:1;min-width:0}
.text-line{display:flex;align-items:flex-start;gap:8px}
.sentence-text{flex:1;min-width:0;overflow-wrap:anywhere;font-family:"Times New Roman","Songti SC",SimSun,serif;font-size:20px;line-height:1.15;color:#101A1C}
.bookmark-space{width:12px;min-width:12px;height:24px;pointer-events:none}
.bookmark{display:block;width:12px;height:24px}
.unavailable{color:#AA7C3F;font-size:13px;margin-top:8px}
.muted{color:#687078}
.ui-button.favorite-action{position:absolute;right:0;top:0;bottom:0;box-sizing:border-box;width:72px;min-height:44px;padding:10px 0;margin:0;border:0;border-radius:0;background:#E8EEE7;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;line-height:1.3;color:#244F3E}
.action-label{font-size:12px}.pending{opacity:.6}
.ui-button.source{box-sizing:border-box;width:100%;min-height:44px;display:flex;align-items:center;text-align:left;color:#687078;font-family:"Times New Roman","Songti SC",SimSun,serif;font-size:14px;line-height:1.4;white-space:normal;overflow-wrap:anywhere;padding:0 0 6px;margin:0;background:transparent;border:0;border-radius:0}
.favorite-row .sentence{display:grid;grid-template-columns:44px minmax(0,1fr);padding:12px 8px 18px;gap:0 8px}
.favorite-row .source{grid-column:2;grid-row:1}
.favorite-row .ui-button.play-target{grid-column:1;grid-row:2;align-self:start}
.favorite-row .copy{grid-column:2;grid-row:2}
@media(max-width:360px){.sentence{gap:6px}.sentence-no{width:27px}.text-line{gap:6px}}
