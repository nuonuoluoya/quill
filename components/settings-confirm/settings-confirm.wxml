<view wx:if="{{kind}}" class="ui-view confirm-overlay" catchtouchmove="noop">
  <view class="ui-view confirm-backdrop" bindtap="cancel"/>
  <view class="ui-view confirm-panel" role="dialog" aria-modal="true" aria-label="{{kind==='audio'?'清除音频缓存':'重置学习进度'}}">
    <view class="ui-view handle"/>
    <button size="default" class="ui-button {{(busy)?'is-disabled':''}} confirm-close" disabled="{{busy}}" bindtap="cancel" aria-label="关闭"><q-icon name="close" size="24"/></button>
    <view class="ui-view confirm-title">{{kind==='audio'?'清除音频缓存？':'重置学习进度？'}}</view>
    <scroll-view scroll-y class="ui-scroll-view confirm-body">
      <block wx:if="{{kind==='audio'}}">
        <view class="ui-view muted intro">仅清理此设备上的音频文件</view>
        <view class="ui-view file-row"><view class="ui-view file-title">原音文件</view><view class="ui-view muted">下次播放时可重新下载</view></view>
        <view class="ui-view file-row recording-row"><view class="ui-view file-title">跟读录音（如有）</view><view class="ui-view danger-text">未上传，删除后无法恢复</view></view>
        <view class="ui-view preserve-note">保留登录状态、学习进度和倍速偏好<view class="ui-view">尚未同步的进度也会保留</view></view>
      </block>
      <block wx:else>
        <view class="ui-view book-title">{{title}}</view><view class="ui-view muted scope">仅限当前内容版本</view>
        <view class="ui-view consequence">将清除{{isBook?'本书':'本内容'}}的阅读位置与倍速偏好。</view>
        <view wx:if="{{loggedIn}}" class="ui-view consequence">同时重置本机与云端记录。<view class="ui-view">其他设备同步后也会生效。</view></view>
        <view wx:else class="ui-view consequence">仅重置此设备上的游客阅读位置与{{isBook?'本书':'本内容'}}倍速偏好，不影响云端或其他设备。</view>
        <view class="ui-view consequence">其他{{isBook?'书籍':'内容'}}及内容版本的进度不受影响。</view>
        <view wx:if="{{pending}}" class="ui-view pending-warning">当前有尚未同步的进度，重置会一并丢弃，无法恢复。</view>
        <view class="ui-view reset-warning"><view class="ui-view warning-symbol" aria-hidden="true">!</view><text class="ui-text">重置后无法撤销。</text></view>
      </block>
    </scroll-view>
    <view class="ui-view confirm-actions"><button size="default" class="ui-button {{(busy)?'is-disabled':''}} cancel-button" disabled="{{busy}}" bindtap="cancel">取消</button><button size="default" class="ui-button {{(busy)?'is-disabled':''}} confirm-button" disabled="{{busy}}" bindtap="confirm">{{busy?(kind==='audio'?'正在清理…':'正在重置…'):(kind==='audio'?'确认清除':'确认重置')}}</button></view>
  </view>
</view>
