<view wx:if="{{state.open}}" class="ui-view shadow-overlay" catchtouchmove="noop">
  <view class="ui-view shadow-backdrop" bindtap="close"/>
  <view class="ui-view shadow-panel" role="dialog" aria-modal="true" aria-label="句子跟读">
    <view class="ui-view handle"/>
    <view class="ui-view panel-heading"><text class="ui-text">句子跟读</text><button size="default" class="ui-button close" bindtap="close" aria-label="关闭跟读"><q-icon name="close" size="25"/></button></view>
    <view class="ui-view sentence-number">第 {{state.number}} 句</view>
    <scroll-view class="ui-scroll-view quote" scroll-y><view class="ui-view quote-text">{{state.text}}</view></scroll-view>
    <view wx:if="{{privacyNeeded}}" class="ui-view privacy-actions">
      <view class="ui-view helper">跟读仅在本机临时保存录音，不上传。开始前请阅读并同意隐私说明。</view>
      <button size="default" class="ui-button privacy-link" bindtap="privacyContract">查看隐私保护指引</button>
      <button id="shadow-privacy-agree" size="default" class="ui-button action primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="privacyAgreed">同意并开始录音</button>
      <button size="default" class="ui-button privacy-link" bindtap="finish">暂不录音</button>
    </view>
    <view wx:else class="ui-view practice-body">
      <view class="ui-view status-line {{state.error?'feedback':''}}" role="status"><block wx:if="{{state.status==='recording'}}"><view class="ui-view record-dot"/>正在录音</block><block wx:else>{{privacyChecking?'正在准备录音':statusText}}</block></view>
      <view class="ui-view listening-slot">
        <view wx:if="{{state.status==='recording'}}" class="ui-view clock">{{clock}}</view>
        <view wx:elif="{{state.status==='preparing' || state.status==='saving' || privacyChecking}}" class="ui-view preparing">{{state.status==='saving'?'请稍候':'准备就绪后开始计时'}}</view>
        <view wx:else class="ui-view two-buttons">
          <button size="default" class="ui-button action outline listen-original {{state.source==='original'?'listening':''}} {{!state.reliable?'is-disabled':''}}" disabled="{{!state.reliable}}" aria-pressed="{{state.source==='original'}}" bindtap="original"><view wx:if="{{state.source==='original'}}" class="ui-view stop-symbol"/><q-icon wx:else name="play" color="green" size="21"/>{{state.source==='original'?'停止原音':'听原音'}}</button>
          <button wx:if="{{state.hasRecording}}" size="default" class="ui-button action outline listen-mine {{state.source==='mine'?'listening':''}}" aria-pressed="{{state.source==='mine'}}" bindtap="mine"><view wx:if="{{state.source==='mine'}}" class="ui-view stop-symbol"/><q-icon wx:else name="play" color="green" size="21"/>{{state.source==='mine'?'停止我的':'听我的'}}</button>
        </view>
      </view>
      <view class="ui-view main-slot">
        <button wx:if="{{state.status==='recording'}}" size="default" class="ui-button action primary main-action" bindtap="finish"><view class="ui-view stop-symbol"/>结束录音</button>
        <button wx:elif="{{state.status==='preparing' || privacyChecking}}" size="default" class="ui-button action outline main-action" bindtap="finish">取消录音</button>
        <button wx:elif="{{state.status==='saving'}}" size="default" class="ui-button action primary main-action is-disabled" disabled>正在保存录音</button>
        <button wx:else size="default" class="ui-button action primary main-action {{!state.reliable?'is-disabled':''}}" disabled="{{!state.reliable}}" bindtap="record"><q-icon name="{{state.hasRecording?'refresh':'microphone'}}" color="white" size="24"/>{{state.hasRecording?'重录':'开始录音'}}</button>
      </view>
      <view class="ui-view helper-slot"><view wx:if="{{state.status==='recording'}}">点一下结束，不用按住 · 最长 60 秒</view><view wx:elif="{{!state.hasRecording && state.status==='ready'}}">首次录音需要麦克风权限</view></view>
    </view>
    <button wx:if="{{state.permissionDenied && !privacyNeeded}}" size="default" class="ui-button privacy-link" bindtap="settings">去开启麦克风</button>
    <view class="ui-view privacy-note">录音仅在本机临时保存</view>
  </view>
</view>
