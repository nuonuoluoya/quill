@import '../../wxss/component.wxss';
:host{display:contents}.shadow-overlay{position:fixed;inset:0;z-index:180}.shadow-backdrop{position:absolute;inset:0;background:rgba(20,25,23,.44)}
.shadow-panel{position:absolute;bottom:0;left:0;right:0;box-sizing:border-box;max-height:80vh;display:flex;flex-direction:column;padding:20px 20px max(10px,calc(env(safe-area-inset-bottom) + 6px));border-radius:22px 22px 0 0;background:#F9F8F5;color:#101A1C}
.handle{position:absolute;top:9px;left:calc(50% - 19px);height:4px;width:38px;border-radius:3px;background:#C5C6C3}.panel-heading{display:flex;align-items:center;justify-content:space-between;min-height:44px;font-family:"Songti SC",SimSun,serif;font-size:26px;font-weight:600;flex-shrink:0}
.close,.ui-button.ui-button.close{display:flex;align-items:center;justify-content:center;width:44px;height:44px;background:none;margin-right:-10px}
.sentence-number{font-size:14px;line-height:22px;color:#687078;margin:8px 0;flex-shrink:0}.quote{flex:0 1 auto;min-height:56px;max-height:180px;box-sizing:border-box;background:#E8EEE7;border-radius:8px;border-left:4px solid #244F3E}.quote-text{padding:12px 16px;font-family:"Times New Roman","Songti SC",SimSun,serif;font-size:21px;line-height:1.4;overflow-wrap:break-word}
.practice-body{flex-shrink:0;display:grid;grid-template-rows:36px 48px 48px 24px;gap:8px;padding-top:12px;box-sizing:border-box}
.action,.ui-button.ui-button.action{display:flex;align-items:center;justify-content:center;gap:10px;height:48px;min-height:48px;padding:9px 12px;width:100%;box-sizing:border-box;border-radius:8px;font-size:18px;margin:0}
.primary,.ui-button.ui-button.primary{background:#244F3E;color:white}.outline,.ui-button.ui-button.outline{border:1px solid #80948D;color:#244F3E;background:transparent}.action.is-disabled,.ui-button.ui-button.action.is-disabled{opacity:.45}.action.listening,.ui-button.ui-button.action.listening{background:#E8EEE7;border-color:#E8EEE7}
.two-buttons{display:flex;gap:8px;height:48px}.two-buttons .action{flex:1;min-width:0;white-space:nowrap}.status-line{display:flex;align-items:center;justify-content:center;gap:8px;text-align:center;font-size:12px;line-height:18px;color:#687078}.helper-slot,.helper{font-size:12px;line-height:19px;text-align:center;color:#687078}.helper-slot{display:flex;align-items:center;justify-content:center}.privacy-note{flex-shrink:0;font-size:11px;line-height:18px;text-align:center;color:#687078;border-top:1px solid #DCDDD8;padding-top:10px;margin-top:8px}
.record-dot{width:9px;height:9px;background:#C56F5E;border-radius:50%;flex-shrink:0}.clock{font-family:"Times New Roman",serif;font-size:42px;line-height:48px;text-align:center}.stop-symbol{width:15px;height:15px;border-radius:2px;background:currentColor;flex-shrink:0}.preparing{display:flex;align-items:center;justify-content:center;height:48px;font-size:14px;color:#687078}.feedback{color:#9C5C39}
.privacy-actions{flex-shrink:0;padding-top:12px}.privacy-link,.ui-button.ui-button.privacy-link{display:flex;align-items:center;justify-content:center;min-height:44px;font-size:14px;color:#244F3E;padding:0 12px;margin:0}
@media(max-height:720px){.shadow-panel{padding-top:16px;padding-left:16px;padding-right:16px}.sentence-number{margin:2px 0 6px}.quote{max-height:130px}.practice-body{padding-top:8px;gap:4px}.privacy-note{margin-top:6px;padding-top:6px}}
