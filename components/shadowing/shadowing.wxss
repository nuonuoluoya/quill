@import '../../wxss/component.wxss';
:host{display:contents}.shadow-overlay{position:fixed;inset:0;z-index:180}.shadow-backdrop{position:absolute;inset:0;background:rgba(20,25,23,.44)}
.shadow-panel{position:absolute;bottom:0;left:0;right:0;box-sizing:border-box;max-height:80vh;display:flex;flex-direction:column;padding:20px 20px calc(12px + env(safe-area-inset-bottom));border-radius:22px 22px 0 0;background:#F9F8F5;color:#101A1C}
.handle{position:absolute;top:9px;left:calc(50% - 19px);height:4px;width:38px;border-radius:3px;background:#C5C6C3}.panel-heading{display:flex;align-items:center;justify-content:space-between;min-height:44px;font-family:"Songti SC",SimSun,serif;font-size:26px;font-weight:600;flex-shrink:0}
.close,.ui-button.ui-button.close{display:flex;align-items:center;justify-content:center;width:44px;height:44px;background:none;margin-right:-10px}
.sentence-number{font-size:14px;line-height:22px;color:#687078;margin:8px 0;flex-shrink:0}.quote{flex:0 1 auto;min-height:56px;max-height:180px;box-sizing:border-box;background:#E8EEE7;border-radius:8px;border-left:4px solid #244F3E}.quote-text{padding:12px 16px;font-family:"Times New Roman","Songti SC",SimSun,serif;font-size:21px;line-height:1.4;overflow-wrap:break-word}
.practice-body{flex-shrink:0;padding-top:10px}.action,.ui-button.ui-button.action{display:flex;align-items:center;justify-content:center;gap:10px;min-height:48px;padding:9px 12px;width:100%;box-sizing:border-box;border-radius:8px;font-size:18px;margin:8px 0 0}
.primary,.ui-button.ui-button.primary{background:#244F3E;color:white}.outline,.ui-button.ui-button.outline{border:1px solid #80948D;color:#244F3E;background:transparent}.action.is-disabled,.ui-button.ui-button.action.is-disabled{opacity:.45}.two-buttons{display:flex;gap:8px}.two-buttons .action{flex:1;min-width:0}.helper{font-size:12px;line-height:19px;text-align:center;color:#687078;margin-top:8px}.ready-mark{display:flex;flex-direction:column;align-items:center;gap:8px;padding:20px 0 10px;color:#687078;font-size:14px}
.privacy-note{flex-shrink:0;font-size:11px;line-height:18px;text-align:center;color:#687078;border-top:1px solid #DCDDD8;padding-top:10px;margin-top:12px}.record-status{display:flex;gap:8px;align-items:center;justify-content:center;color:#687078;font-size:14px;margin-top:14px}.record-dot{width:9px;height:9px;background:#C56F5E;border-radius:50%}.clock{font-family:"Times New Roman",serif;font-size:46px;line-height:1.4;text-align:center;margin:6px 0 24px}.stop-symbol{width:15px;height:15px;border-radius:2px;background:currentColor}
.redo,.ui-button.ui-button.redo,.old-recording,.ui-button.ui-button.old-recording{display:flex;align-items:center;justify-content:center;gap:10px;min-height:44px;margin:10px auto 0;font-size:16px;padding:0 16px}.recorded-label{margin:0 0 2px}.preparing{text-align:center;padding:26px 0;color:#687078}.feedback{font-size:12px;line-height:18px;color:#9C5C39;margin-top:8px;flex-shrink:0}.open-settings,.ui-button.ui-button.open-settings{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:0 14px;color:#244F3E}
.source-card{border:1px solid #DCDDD8;border-radius:8px;padding:8px 10px;margin-bottom:7px}.source-heading{display:flex;gap:10px;align-items:center;font-size:15px}.source-badge{display:flex;align-items:center;justify-content:center;width:25px;height:25px;border-radius:50%;background:#E8EEE7;font-family:"Times New Roman",serif}.active .source-badge{background:#244F3E;color:white}.source-state{margin-left:auto;font-size:12px;color:#687078}.active .source-state{color:#244F3E}.progress{height:4px;border-radius:3px;background:#DFE0DC;margin-top:9px;overflow:hidden}.progress .ui-view{height:100%;background:#244F3E}.times{display:flex;justify-content:space-between;font-size:11px;color:#687078;line-height:16px;margin-top:4px}
@media(max-height:720px){.shadow-panel{padding-top:16px;padding-left:16px;padding-right:16px}.sentence-number{margin:2px 0 6px}.quote{max-height:130px}.ready-mark{padding:10px 0 4px;gap:4px}.privacy-note{margin-top:8px;padding-top:6px}.clock{margin-bottom:12px}.source-card{padding:5px 8px}.helper{margin-top:5px}}
.practice-body{min-height:290px;box-sizing:border-box;display:flex;flex-direction:column;justify-content:center}.practice-body>.ui-view,.practice-body>.ui-button{flex-shrink:0}.times{min-height:16px}
@media(max-height:720px){.practice-body{min-height:240px}.source-card{padding:3px 8px;margin-bottom:5px}.source-badge{width:22px;height:22px}.progress{margin-top:5px}.times{margin-top:2px;line-height:14px;min-height:14px}.helper{margin-top:4px;line-height:18px}}
