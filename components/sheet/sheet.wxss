:host{display:contents}.overlay{position:fixed;inset:0;z-index:100}.backdrop{position:absolute;inset:0;background:rgba(20,25,23,.44)}.sheet{position:absolute;left:0;right:0;bottom:0;box-sizing:border-box;background:#F9F8F5;border-radius:22px 22px 0 0;padding:46px 22px calc(24px + env(safe-area-inset-bottom));animation:sheet-enter 200ms ease-out}.handle{position:absolute;top:13px;left:calc(50% - 21px);width:42px;height:5px;border-radius:5px;background:#C5C6C3}.heading{font-family:"Songti SC",SimSun,serif;font-size:27px;font-weight:600;line-height:1.4;margin-bottom:10px;color:#101A1C}.sheet-close,.ui-button.ui-button.sheet-close{position:absolute;top:18px;right:16px;display:flex;align-items:center;justify-content:center;width:34px;height:34px;background:none;border:0;margin:0;padding:0}.sheet-close::after,.ui-button.ui-button.sheet-close::after{border:0}.body{max-height:65vh}@keyframes sheet-enter{from{transform:translateY(24px);opacity:.5}to{transform:translateY(0);opacity:1}}@media(prefers-reduced-motion:reduce){.sheet{animation:none}}
