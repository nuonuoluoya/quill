@import '../../wxss/catalog.wxss';
.reader{height:100vh;display:flex;flex-direction:column;overflow:hidden}.reader q-nav,.reader q-player-dock{flex-shrink:0}.reader-top{padding:16px 18px 0;flex-shrink:0}.reader-heading{display:flex;align-items:center;gap:14px;justify-content:space-between;margin:0 0 18px}.reader-title{font-size:43px;line-height:1.12;letter-spacing:-1px;min-width:0;overflow-wrap:break-word}.chapter-button,button[size="default"].chapter-button{display:flex;align-items:center;gap:4px;border:1px solid #D4D7D1;border-radius:20px;padding:6px 12px;font-size:13px;white-space:nowrap;flex-shrink:0}.search{padding:10px 14px;display:flex;align-items:center;gap:10px;background:#EEEDE8;border-radius:15px}.search input{flex:1;font-size:15px;min-width:0;line-height:22px;height:22px}.reader-mode{display:flex;align-items:center;justify-content:space-between;min-height:64px;font-size:14px;gap:12px;border-bottom:1px solid #DCDDD8}.full-play,button[size="default"].full-play{display:flex;align-items:center;gap:6px;border:1px solid #608177;border-radius:9px;padding:7px 12px;font-size:13px;white-space:nowrap}.sentences{flex:1;min-height:0;height:0}.sentence{display:flex;align-items:flex-start;gap:22px;padding:20px 14px;margin:0 5px;position:relative;min-height:72px}.sentence::after{content:"";position:absolute;bottom:0;left:13px;right:13px;height:1px;background:#DCDDD8}.sentence.selected{background:#E8EEE7;border-radius:10px}.sentence.selected::before{content:"";position:absolute;left:0;top:5px;bottom:5px;width:4px;background:#2C624D;border-radius:3px}.sentence.selected::after{display:none}.sentence-no{font-family:"Times New Roman",serif;font-size:14px;color:#687078;line-height:1.6;min-width:31px;margin-top:3px}.sentence-play{width:20px;flex-shrink:0;padding-top:4px}.sentence-text{font-family:"Times New Roman","Songti SC",SimSun,serif;font-size:21px;line-height:1.35}.unavailable{color:#AA7C3F;font-size:13px;margin-top:8px}.sheet-book{font-size:15px;padding-bottom:22px;border-bottom:1px solid #DCDDD8}.sheet-hint{font-size:12px;text-align:center;color:#818786;margin:26px 0 8px}.reader-top .notice,.reader-top button[size="default"].notice{margin:0 0 10px}.reader-top .quiet,.reader-top button[size="default"].quiet{padding:8px 0}

.reader-top{padding-top:26px}.reader-title{font-size:48px}
