.season-picker{margin:18px 0 12px}.season-select{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:13px 16px;border:1px solid #C6D3C8;border-radius:12px;background:#EDF2EC;color:#28543F;min-height:48px;box-sizing:border-box}.season-select-copy{min-width:0}.season-select-title{display:block;font-size:16px;font-weight:600;overflow-wrap:break-word}.season-select-count{display:block;font-size:12px;color:#687078;margin-top:3px}.season-select-action{display:flex;align-items:center;gap:6px;font-size:13px;white-space:nowrap}.episode-no{min-width:42px}.season-list-title{font-size:16px;font-weight:600;margin:18px 0 6px;overflow-wrap:break-word}
